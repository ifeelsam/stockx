# Copy to .env.local / .env (gitignored). Never commit real values.

# --- web / mobile (public) ---
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SOLANA_RPC=https://rpc.magicblock.app/devnet
NEXT_PUBLIC_ROUTER_RPC=https://devnet-router.magicblock.app
NEXT_PUBLIC_KEEPER_URL=http://localhost:8787
# --- web server only ---
PRIVY_APP_SECRET=

# --- keeper (services/keeper) ---
PORT=8787
RPC_URL=                           # base-layer RPC; default MagicBlock devnet
REGION=asia                        # rollup region: asia | eu | us
KEEPER_KEYPAIR_PATH=               # default ~/.config/stockx/keeper.json (price pusher + payout repair)
FAUCET_AUTHORITY_KEYPAIR_PATH=     # default ~/.config/stockx/deployer.json (mint authority + SOL drip)
DEPLOYMENTS=                       # default deployments/devnet.json
PRICE_SOURCE=hermes                # hermes | pythpro | dev (synthetic random walk, devnet demos only)
HERMES_URL=https://hermes.pyth.network
PYTH_PRO_TOKEN=                    # Pyth Pro bearer token (secret: deployment secret only, never commit)
PYTH_PRO_URL=https://pyth.dourolabs.app
HERMES_AUTH_HEADER=                # "Header-Name: value". Public Hermes price endpoints answer 401 (checked 2026-11-24)
REPAIR_GRACE_MS=20000
FAUCET_ORIGIN=*                    # CORS origin of the web app
FAUCET_COOLDOWN_MS=3600000
REFILL_STOCK=0                     # 1 = devnet mock vault refill

# --- scripts ---
DEPLOYER_KEYPAIR=                  # default ~/.config/stockx/deployer.json
