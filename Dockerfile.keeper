# Keeper image, used by Vercel (vercel.json) and Fly (services/keeper/fly.toml). The build context is the repo root:
#   docker build -f Dockerfile.keeper -t scratchers-keeper .
FROM node:22-slim
# slim has no CA store; Vercel's daemon runtime looks for one
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /repo
# Whole workspace: a frozen lockfile needs every importer's package.json present.
COPY . .
RUN pnpm install --frozen-lockfile --filter @scratchers/keeper...
RUN pnpm --filter @scratchers/sdk build
ENV DEPLOYMENTS=/repo/deployments/devnet.json
EXPOSE 8787
WORKDIR /repo/services/keeper
# Secrets via env (never baked in): KEEPER_KEYPAIR_JSON, FAUCET_AUTHORITY_KEYPAIR_JSON, PYTH_PRO_TOKEN
# node directly: no package manager download at start-up, and signals reach the process.
CMD ["node", "--import", "tsx", "src/index.ts"]
