{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "pnpm -w turbo run build --filter=@scratchers/web"
    },
    "keeper": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.keeper-web"
    }
  },
  "daemons": {
    "keeper-worker": {
      "root": ".",
      "entrypoint": "Dockerfile.keeper",
      "instances": { "sin1": 1 },
      "resources": { "requests": { "memory": "1Gi" } },
      "livenessProbe": { "httpGet": { "port": 8787, "path": "/healthz" }, "initialDelaySeconds": 20 }
    }
  },
  "rewrites": [
    { "source": "/keeper/(.*)", "destination": { "service": "keeper" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
