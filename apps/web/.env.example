# Privy (public app id; the secret is NOT needed by the web app)
NEXT_PUBLIC_PRIVY_APP_ID=
# mock = in-browser simulated game (default until devnet deploy); chain = real devnet via the SDK
NEXT_PUBLIC_BACKEND=mock
NEXT_PUBLIC_BASE_RPC=https://rpc.magicblock.app/devnet
# leave unset on Vercel: production builds default to /keeper on the same domain
NEXT_PUBLIC_KEEPER_URL=http://localhost:8787
# chain mode reads /deployments.json (copied there by `pnpm --filter @scratchers/scripts setup:devnet`)
